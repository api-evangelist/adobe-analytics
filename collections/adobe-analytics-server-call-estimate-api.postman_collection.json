      "name": "Server Call Estimate",
      "description": {
        "content": "Estimate the scope and cost of a repair job",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "bc7db617-921c-4909-89c0-25dbb9da7d71",
          "name": "Adobe Analytics Get Server Call Estimate",
          "request": {
            "name": "Adobe Analytics Get Server Call Estimate",
            "description": {
              "content": "Calculates the number of data rows that would be scanned for a repair job given the specified report suite and date range. This estimate is required before creating a repair job and returns a validationToken that must be passed to the job creation endpoint. The count determines the cost of the repair.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                ":rsid",
                "serverCallEstimate"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "dateRangeStart",
                  "value": "<date>",
                  "description": "(Required) Start of the date range for the repair in ISO 8601 format (YYYY-MM-DD)"
                },
                {
                  "disabled": false,
                  "key": "dateRangeEnd",
                  "value": "<date>",
                  "description": "(Required) End of the date range for the repair (inclusive) in ISO 8601 format (YYYY-MM-DD)"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "rsid",
                  "description": "(Required) The report suite ID"
                },
                {
                  "description": "The global company ID for your Adobe Analytics organization",
                  "type": "any",
                  "value": "{{globalCompanyId}}",
                  "key": "globalCompanyId"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
