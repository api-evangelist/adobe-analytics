        {
          "id": "b45661a3-e0c0-4b4e-91f9-e588fa9e49ad",
          "name": "Adobe Analytics Upload a Batch Events File",
          "request": {
            "name": "Adobe Analytics Upload a Batch Events File",
            "description": {
              "content": "Uploads a gzip-compressed CSV file containing batched Analytics event data. Each row in the CSV represents one Analytics hit. The file must include required columns (timestamp, marketingCloudVisitorID or customerID, and reportSuiteID) and may include any additional Analytics variables. The visitor group ID header (x-adobe-vgid) is required and must match the visitor group used for all files in a sequence to ensure correct visitor stitching.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "events"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "The global company ID for your Adobe Analytics organization",
                  "type": "any",
                  "value": "{{globalCompanyId}}",
                  "key": "globalCompanyId"
                }
              ]
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) The visitor group ID. All files for the same visitors must share the same visitor group ID to ensure correct visitor stitching.",
                "key": "x-adobe-vgid",
                "value": "<string>"
              },
              {
                "disabled": false,
                "description": "Optional unique identifier for the upload for deduplication. Duplicate uploads with the same key are rejected.",
                "key": "x-adobe-idempotency-key",
                "value": "<string>"
              },
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "description": "(Required) Gzip-compressed CSV file containing event data"
                }
              ]
            }
          },
          "response": [
            {
              "id": "26a1277f-bea5-4d16-a463-ff565457d686",
              "name": "File uploaded and queued for processing",
