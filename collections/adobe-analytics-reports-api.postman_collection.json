          "request": {
            "name": "Adobe Analytics Run a Report",
            "description": {
              "content": "Runs an analytics report based on the provided report request definition. The request body specifies metrics, dimensions, date ranges, filters, and other parameters to define the report output.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "reports"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "The global company ID for your Adobe Analytics organization",
                  "type": "any",
                  "value": "{{globalCompanyId}}",
                  "key": "globalCompanyId"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rsid\": \"<string>\",\n  \"globalFilters\": [\n    {\n      \"type\": \"<string>\",\n      \"dateRange\": \"<string>\",\n      \"segmentId\": \"<string>\",\n      \"dimension\": \"<string>\",\n      \"itemId\": \"<string>\"\n    },\n    {\n      \"type\": \"<string>\",\n      \"dateRange\": \"<string>\",\n      \"segmentId\": \"<string>\",\n      \"dimension\": \"<string>\",\n      \"itemId\": \"<string>\"\n    }\n  ],\n  \"metricContainer\": {\n    \"metrics\": [\n      {\n        \"id\": \"<string>\",\n        \"columnId\": \"<string>\",\n        \"filters\": [\n          \"<string>\",\n          \"<string>\"\n        ],\n        \"sort\": \"<string>\"\n      },\n      {\n        \"id\": \"<string>\",\n        \"columnId\": \"<string>\",\n        \"filters\": [\n          \"<string>\",\n          \"<string>\"\n        ],\n        \"sort\": \"<string>\"\n      }\n    ],\n    \"metricFilters\": [\n      {\n        \"type\": \"<string>\",\n        \"dateRange\": \"<string>\",\n        \"segmentId\": \"<string>\",\n        \"dimension\": \"<string>\",\n        \"itemId\": \"<string>\"\n      },\n      {\n        \"type\": \"<string>\",\n        \"dateRange\": \"<string>\",\n        \"segmentId\": \"<string>\",\n        \"dimension\": \"<string>\",\n        \"itemId\": \"<string>\"\n      }\n    ]\n  },\n  \"locale\": \"<string>\",\n  \"dimension\": \"<string>\",\n  \"settings\": {\n    \"limit\": 50,\n    \"page\": 0,\n    \"nonesBehavior\": \"<string>\"\n  },\n  \"statistics\": \"<object>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
