          "id": "bf19e004-d845-4bd2-b9ce-42e458773f58",
          "name": "Adobe Analytics Create a Data Repair Job",
          "request": {
            "name": "Adobe Analytics Create a Data Repair Job",
            "description": {
              "content": "Creates and starts a new data repair job for the specified report suite and date range. The validationToken from the serverCallEstimate endpoint must be included as a query parameter. The request body defines which variables to repair and what actions to take (delete or set).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                ":rsid",
                "job"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "validationToken",
                  "value": "<string>",
                  "description": "(Required) The token returned by the serverCallEstimate endpoint, confirming you have reviewed the cost estimate"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "rsid",
                  "description": "(Required) The report suite ID"
                },
                {
                  "description": "The global company ID for your Adobe Analytics organization",
                  "type": "any",
                  "value": "{{globalCompanyId}}",
                  "key": "globalCompanyId"
                }
              ]
            },
