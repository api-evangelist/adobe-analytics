                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"variables\": {\n    \"key_0\": {\n      \"action\": \"<string>\",\n      \"setValue\": \"<string>\",\n      \"filter\": {\n        \"condition\": \"<string>\",\n        \"matchValue\": \"<string>\"\n      }\n    }\n  }\n}",
